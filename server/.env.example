# Copy this file to .env and fill in the values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/osint_dashboard

# GitHub personal access token (optional, raises rate limit from 60/hr to 5000/hr)
GITHUB_TOKEN=

# Reddit (optional). Reddit asks for a descriptive User-Agent, e.g. "OpenSourceDashboard/1.0 (by u/yourname)"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=OpenSourceDashboard/1.0.0
